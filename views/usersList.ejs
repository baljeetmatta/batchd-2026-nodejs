<html>
    <body>
        <h3>Users</h3>
        <div>
            <table>
                <tr><th>Name</th><th>Username</th><th>Password</th></tr>

                <% users.forEach((user)=>{%>
                        <tr>
                            <td><%=user.name%></td>
                            <td><%=user.username%></td>
                            <td><%=user.password%></td>
                        </tr>


                <%})%>
            </table>
        </div>
    </body>
</html>